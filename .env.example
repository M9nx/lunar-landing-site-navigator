# Copy to .env on the team server. Never commit .env.

# --- Legacy single-user research (optional profile) ---
JUPYTER_TOKEN=replace-with-a-long-random-token

# --- API (FastAPI) ---
# Exact browser Origins (no paths), comma-separated
ALLOWED_ORIGINS=https://m9nx.me,https://m9nx.github.io,http://localhost:8765,http://127.0.0.1:8765,http://localhost:8000,http://127.0.0.1:8000
API_PUBLIC_URL=https://api.m9nx.me
# Separate GitHub OAuth app for the API (not the Hub app)
API_GITHUB_CLIENT_ID=
API_GITHUB_CLIENT_SECRET=
# Comma-separated GitHub logins allowed to sign in to the API
APPROVED_GITHUB_USERS=
SESSION_SECRET=replace-with-a-long-random-secret
# lax for same-site (m9nx.me + api.m9nx.me); none for cross-site (github.io + api.m9nx.me)
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true
# Where to send the browser after API OAuth (static prototype URL, no secrets)
API_OAUTH_SUCCESS_REDIRECT=https://m9nx.me/lunar-landing-site-navigator/prototype/
SCIENCE_CALCULATIONS_READY=false
# Break-glass revocation: DELETE /admin/sessions/{login} with header X-Admin-Token
API_ADMIN_TOKEN=

# --- JupyterHub (absolute host paths for spawned notebook bind mounts) ---
HOST_SHARED_NOTEBOOKS=/absolute/path/to/lunar-landing-site-navigator/research/notebooks
HOST_DATA_PATH=/absolute/path/to/lunar-landing-site-navigator/data
HUB_PUBLIC_URL=https://hub.m9nx.me
# GitHub OAuth app callback (must match exactly). If empty, Hub uses:
#   ${HUB_PUBLIC_URL}/hub/oauth_callback
# Production example:
# HUB_OAUTH_CALLBACK_URL=https://hub.m9nx.me/hub/oauth_callback
HUB_OAUTH_CALLBACK_URL=
HUB_GITHUB_CLIENT_ID=
HUB_GITHUB_CLIENT_SECRET=
JUPYTERHUB_CRYPT_KEY=replace-with-32-byte-hex-or-openssl-rand-hex-32
CONFIGPROXY_AUTH_TOKEN=replace-with-a-long-random-token
# Comma-separated GitHub logins allowed to spawn notebooks
JUPYTERHUB_ALLOWED_USERS=
# Comma-separated Hub admins (GitHub logins)
JUPYTERHUB_ADMIN_USERS=
# Optional: org:team entries for c.GitHubOAuthenticator.allowed_organizations (requires read:org)
# JUPYTERHUB_ALLOWED_ORGANIZATIONS=
